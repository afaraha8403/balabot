# BalaBot — secrets. NEVER commit this file.
#
# Jev is a HARD dependency. The container validates this key at startup and
# exits loudly if it is missing or rejected. There is no fallback provider.
TYPESAFE_API_KEY=

# Model provider (default: OpenRouter). Required.
OPENROUTER_API_KEY=

# --- Optional ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Agent API key — this is what the product UI (and anything else) uses to talk to
# the agents' OpenAI-compatible endpoints at /p/<profile>/v1.
#
#   principal -> http://127.0.0.1:8642/p/principal/v1
#   governor  -> http://127.0.0.1:8642/p/governor/v1
#   Authorization: Bearer <this value>, model id = the profile name
#
# One multiplexed listener serves every profile, but each profile's listener is
# authenticated with a PROFILE-SCOPED key. Bootstrap propagates this single value
# into every profile's .env, so you only manage it here. If it is empty the
# profiles' listeners 401 every request ("no profile-scoped API_SERVER_KEY is
# configured") and the UI's chat silently dies.
#
# Generate one with:  openssl rand -hex 32
# API_SERVER_KEY=

# Telegram gateway (issue per persona via @BotFather — never share one token
# between two agents: two pollers on one token race on every message).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=

# Cloudflare tunnel — BAKED IN and pre-wired, DORMANT until you add a token.
# Nothing is exposed while this is empty. Supply a token and restart the
# container to bring the tunnel up. Full walkthrough: docs/cloudflare-tunnel.md
#
# The value is passed through the environment, never argv, so it cannot appear
# in `ps`; it is never written to the log either. Prefer a mounted secret file
# where your platform supports one.
# CLOUDFLARE_TUNNEL_TOKEN=
# CLOUDFLARE_TUNNEL_TOKEN_FILE=/run/secrets/cloudflare_tunnel_token
#
# Secrets store encryption master key (AES-256-GCM authenticated encryption at rest).
# If unset, BalaBot safely auto-generates a 32-byte key at BALABOT_SECRETS_KEY_PATH
# (safe local default: <BALABOT_DATA_ROOT>/.secrets/master.key with 0600 mode).
# In production, supply a 64-character hex key or explicit key file path:
# BALABOT_SECRETS_KEY=
# BALABOT_SECRETS_KEY_PATH=/opt/data/.secrets/master.key
#
# Screen-lease store (one agent holds one display/session resource at a time).
# SQLite database holding leases and their immutable audit trail. Defaults to
# <BALABOT_DATA_ROOT>/screen_leases/screen_leases.db when unset.
# BALABOT_SCREEN_LEASES_DB=/opt/data/screen_leases/screen_leases.db
#
# --- Coding-agent CLI environment (local only) ---
# Agents driving this repo (Antigravity/Gemini CLI, Codex, Claude Code) read the
# same values from `.env.local` (gitignored) so a session can call Jev, the model
# provider and Cloudflare without a value ever entering chat:
#
#   set -a; . .env.local; set +a
#
# Keys mirrored there: TYPESAFE_API_KEY, OPENROUTER_API_KEY, API_SERVER_KEY,
# CLOUDFLARE_TUNNEL_TOKEN, BALABOT_DASHBOARD_PASSWORD.

