{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "balabot-edge",
  "main": "src/index.ts",
  "compatibility_date": "2024-10-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../ui/dist"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BalaBotAgent",
        "class_name": "BalaBotAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BalaBotAgent"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
