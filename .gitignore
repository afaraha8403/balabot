# Secrets NEVER get committed.
.env
.env.*
# ...but the TEMPLATE must ship, or `cp .env.example .env` fails for every
# new clone.
!.env.example
*.pem
*.key

# Local state / build artifacts
__pycache__/
*.pyc
*.db
*.sqlite3
.venv/
venv/
# Runtime logs. The adapter writes ui/server.log next to itself; it is
# transient output, not source — committing it would bake today's startup
# noise into the repo and make every run look like a diff.
*.log

# Editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
ui/node_modules/
ui/dist/
ui/tsconfig.tsbuildinfo
